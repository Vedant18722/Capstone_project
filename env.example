# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Central AI Engine for Claude API analysis.
# Set this in your environment or .env file to enable direct Anthropic Claude API calls.
ANTHROPIC_API_KEY="sk-ant-api03-..."

# GOOGLE_SHEETS: Optional webhook or Sheet ID for saving financial assessment records.
GOOGLE_SHEET_ID="your_google_sheet_id_here"
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycb.../exec"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

